\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ructhesis}[2026/04/20 RUC Undergraduate Thesis Template]

% ==========================================
% 1. 基础功能与排版宏包
% ==========================================
\RequirePackage{amsmath, amssymb}            % 数学公式支持
\RequirePackage{graphicx, float, subcaption} % 图片与浮动体控制
\RequirePackage{booktabs, multirow, array, tabularx}   % 三线表与复杂表格
\RequirePackage{threeparttable}              % 带尾注的表格
\RequirePackage{geometry}                    % 页面边距布局
\RequirePackage{fancyhdr}                    % 页眉页脚控制
\RequirePackage{setspace}                    % 行距控制
\RequirePackage{titletoc, titlesec}          % 目录与多级标题自定义
\RequirePackage{caption}                     % 图表标题自定义
\RequirePackage{enumitem, enumerate}         % 列表环境
\RequirePackage{pifont}                      % 特殊符号 (用于脚注)
\RequirePackage[perpage,symbol*]{footmisc}   % 脚注控制
\RequirePackage{appendix}                    % 附录支持
\RequirePackage{xcolor}                      % 颜色支持
\RequirePackage{tikz}                        % 绘图支持
\usetikzlibrary{shapes.geometric, decorations.pathreplacing}
\RequirePackage{hyperref}                    % 超链接
\RequirePackage{etoolbox}                    % 用于提供 \AtBeginEnvironment 钩子命令
\RequirePackage{adjustbox}

% ==========================================
% 2. 页面与字体全局设置 (适配 XeLaTeX)
% ==========================================
\RequirePackage{fontspec}
\RequirePackage{mathptmx}
\RequirePackage[T1]{fontenc}

% 1. 强制正文 \textbf 使用宋体伪粗体
\RequirePackage{xeCJK}

% 1. 开启全角标点模式
\xeCJKsetup{PunctStyle=quanjiao} 

% 2. 【关键修复】强制让所有中文标点使用规范的字体渲染
% \setCJKpunctfont{STSong}

\setCJKmainfont{STSong}[
    BoldFont={STSong},
    BoldFeatures={FakeBold=5},
    ItalicFont={Kaiti SC}
]

% 2. 设置标题与黑体族 (黑体)
% 这样设置后，当你使用 \heiti \bfseries 时，系统会自动调用 Heiti SC Medium
\setCJKsansfont{Heiti SC}[
    BoldFont={Heiti SC Medium} 
]

% 如果你觉得 Medium 还不够粗，想要“更黑”的效果，也可以用伪粗体：
% \setCJKsansfont{Heiti SC}[
%     BoldFont={Heiti SC},
%     BoldFeatures={FakeBold=2.5}
% ]

% 3. 这里的设置是为了兼容 ctex 原生的 \heiti 命令
\setCJKfamilyfont{zhhei}{Heiti SC}[BoldFont={Heiti SC Medium}]
\renewcommand*{\heiti}{\CJKfamily{zhhei}}

% 页面边距：依据教务处指导手册
\geometry{a4paper, left=2cm, right=1.5cm, top=2cm, bottom=2cm}

% 超链接设为纯黑打印格式
\hypersetup{
    colorlinks=true,
    linkcolor=black,   % 目录、交叉引用等内部链接颜色
    citecolor=black,   % 参考文献引用颜色
    urlcolor=black     % 网址链接颜色
}

% 图表标题间距与字体设定
\captionsetup{font={small}, labelfont={bf}} 
\captionsetup[table]{skip=3pt}
\captionsetup[figure]{skip=3pt}

% 脚注设定：每页更新的圆形编号
\DefineFNsymbols{circled}{{\ding{192}}{\ding{193}}{\ding{194}}{\ding{195}}{\ding{196}}{\ding{197}}{\ding{198}}{\ding{199}}{\ding{200}}{\ding{201}}}
\setfnsymbol{circled}

% 设置图表标题分隔符
% 1. 声明一个名叫 zhcolon 的自定义分隔符，内容为全角冒号
\DeclareCaptionLabelSeparator{zhcolon}{：} 

% 2. 在全局设置中强行应用这个分隔符
\captionsetup{
    font={small}, 
    labelfont={bf},
    labelsep=zhcolon % 全局强制使用全角冒号
} 
\captionsetup[table]{skip=3pt}
\captionsetup[figure]{skip=3pt}

% 表格行距调整：1.25倍行距
\renewcommand{\arraystretch}{1.25}
\setlength{\heavyrulewidth}{1.5pt}

% ==========================================
% 3. 标题与目录格式重定义
% ==========================================
% 目录引线与字体
\titlecontents{section}[2.3em]{\heiti}{\contentslabel{2.3em}}{\hspace*{-2.3em}}{\titlerule*[1pc]{.}\contentspage}

% 各级标题格式：黑体、加粗、单倍行距、段前段后1行
\titleformat{\section}{\centering \zihao{3} \heiti \bfseries}{\thesection}{1em}{}
\titleformat{\subsection}{\flushleft \zihao{4} \heiti \bfseries}{\thesubsection}{1em}{}
\titleformat{\subsubsection}{\flushleft \zihao{-4} \heiti \bfseries}{\thesubsubsection}{1em}{}

% ==========================================
% 4. 页眉页脚样式初始化
% ==========================================
\pagestyle{fancy}
\fancyhf{} % 清空默认
% \setlength{\headheight}{33pt}
% 居中放置校徽（确保当前目录下有 head.png）
\chead{\includegraphics[width=4.13cm, height=0.98cm]{head.png}}

% ==========================================
% 5. 摘要环境与辅助命令
% ==========================================
% 中文摘要
\renewcommand{\abstractname}{\textbf{\Large \heiti 摘要}}
\renewenvironment{abstract}{%
    \par\small
    \noindent\mbox{}\hfill{\bfseries \abstractname}\hfill\mbox{}\par
    \vskip 2.5ex}{\par\vskip 2.5ex} 

% 英文摘要
\newcommand{\enabstractname}{\textbf{\Large Abstract}}
\newenvironment{enabstract}{%
    \par\small
    \noindent\mbox{}\hfill{\bfseries \enabstractname}\hfill\mbox{}\par
    \vskip 2.5ex}{\par\vskip 2.5ex} 

% 封面下划线排版工具
\newcommand\dunderline[3][-1pt]{{%
  \setbox0=\hbox{#3}
  \ooalign{\copy0\cr\rule[\dimexpr#1-#2\relax]{\wd0}{#2}}}}


% ==========================================
% 6. 附录自动化增强模块
% ==========================================
\RequirePackage{etoolbox}

% 当进入 appendices 环境时，自动执行以下初始化
\AtBeginEnvironment{appendices}{
    % 1. 自动插入一个居中的“附录”大标题（不带 A/B 编号）
    % \section* 会继承你 sty 中定义的居中、三号、黑体等样式，但不计入编号
    \section*{附录}
    
    % 2. 手动将其加入目录（因为 \section* 默认不进目录）
    % \addcontentsline{toc}{section}{附录}
    
    % 3. 定义随后 \section 的编号显示方式：使 \thesection 仅显示 A, B, C...
    % 这样做是为了让图表编号 \thesection.\arabic{table} 显示为 A.1 而不是 “附录 A.1”
    \renewcommand{\thesection}{\Alph{section}}
    
    % 4. 重新定义此环境下 \section 的标题样式，使其显示为 “附录 A  XXXX”
    % 格式（居中、字号）依然保持与你的原 sty 一致
    \titleformat{\section}
        {\flushleft \zihao{3} \heiti \bfseries}
        {附录 \thesection}  % 在这里硬编码“附录”两个字
        {1em}
        {}
        
    % 5. 图表重命名与编号逻辑（附图 A.1）
    \renewcommand{\figurename}{附图}
    \renewcommand{\tablename}{附表}
    \renewcommand{\thefigure}{\thesection.\arabic{figure}}
    \renewcommand{\thetable}{\thesection.\arabic{table}}
    
    % 6. 计数器绑定：每增加一个 \section，图表序号清零
    \makeatletter
    \@addtoreset{figure}{section}
    \@addtoreset{table}{section}
    \makeatother
}
\endinput